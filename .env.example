# Copy to .env.local and fill in. Server-side only: never prefix these with NEXT_PUBLIC_.

# Required for the live AI court. Create one at https://platform.claude.com/settings/keys
# (A Claude / Claude Code subscription is not an API key.)
ANTHROPIC_API_KEY=your-api-key-here

# Optional. Defaults to claude-opus-5-5 (current Opus; supports structured outputs).
# Any model that supports structured outputs works, e.g. claude-sonnet-5-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5-5
